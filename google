from pydantic import BaseModel, Field
import torch
from typing import List
from factory import build_model
import os

app = FastAPI(
    title="ML Model Serving API",
    description="Production inference endpoint for Epic model architectures",
    version="1.0.0"
)

# Global placeholders for model and device
model = None
DEVICE = torch.device("cuda" if torch.cuda.is_available() else "cpu")

class InferenceRequest(BaseModel):
    features: List[float] = Field(..., description="Input feature vector matching model input dimension")

class InferenceResponse(BaseModel):
    prediction: int
    probabilities: List[float]

@app.on_event("startup")
def load_production_model():
    global model
    
    # Configuration matching your trained pipeline
    config = {
        "architecture": "mlp",
        "params": {
            "input_dim": 128,
            "hidden_dim": 64,
            "output_dim": 2,
            "num_layers": 3
        }
    }
    
    model = build_model(config)
    
    # Load best checkpoint weights if available
    checkpoint_path = "./checkpoints/best_model.pt"
    if os.path.exists(checkpoint_path):
        checkpoint = torch.load(checkpoint_path, map_location=DEVICE)
        model.load_state_dict(checkpoint['model_state_dict'])
        print(f"Loaded checkpoint from epoch {checkpoint['epoch']} with val_loss: {checkpoint['val_loss']:.4f}")
    else:
        print("Warning: No checkpoint found. Using randomly initialized model weights.")
        
    model.to(DEVICE)
    model.eval()

@app.post("/predict", response_model=InferenceResponse)
def predict(payload: InferenceRequest):
    if len(payload.features) != 128:
        raise HTTPException(status_code=400, detail="Invalid input dimension. Expected 128 features.")
    
    with torch.no_grad():
        tensor_input = torch.tensor([payload.features], dtype=torch.float32).to(DEVICE)
        logits = model(tensor_input)
        probabilities = torch.softmax(logits, dim=1).squeeze().tolist()
        prediction = torch.argmax(logits, dim=1).item()
        
    return InferenceResponse(
        prediction=prediction,
        probabilities=probabilities if isinstance(probabilities, list) else [probabilities]
    )

@app.get("/health")
def health_check():
    return {"status": "healthy", "device": str(DEVICE)}FROM python:3.9-slim

